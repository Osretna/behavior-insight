{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Authenticated guardian account metadata and security settings.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["guardian"] },
        "preferredLanguage": { "type": "string", "enum": ["ar", "en"] },
        "theme": { "type": "string", "enum": ["dark", "light"] },
        "pinEnabled": { "type": "boolean" },
        "pinHash": { "type": "string", "maxLength": 256 },
        "subscriptionStatus": { "type": "string", "enum": ["active", "suspended"] },
        "validFrom": { "type": "string", "maxLength": 10 },
        "validUntil": { "type": "string", "maxLength": 10 },
        "subscriptionPlanLabel": { "type": "string", "maxLength": 80 },
        "subscriptionPrice": { "type": "number" },
        "lastLoginAt": { "type": "string", "maxLength": 64 },
        "deviceInfo": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "preferredLanguage", "theme", "createdAt", "updatedAt"]
    },
    "MonitoredProfile": {
      "title": "MonitoredProfile",
      "description": "Profile of a person being evaluated across the four behavioral axes.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "age": { "type": "integer" },
        "city": { "type": "string", "maxLength": 100 },
        "country": { "type": "string", "maxLength": 100 },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "avatarColor": { "type": "string", "maxLength": 32 },
        "weights": { "type": "object" },
        "prayerAlertsEnabled": { "type": "boolean" },
        "dailyGoalMinutes": { "type": "integer" },
        "activeStreak": { "type": "integer" },
        "totalPoints": { "type": "integer" },
        "totalStars": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "name", "age", "weights", "prayerAlertsEnabled", "dailyGoalMinutes", "activeStreak", "totalPoints", "totalStars", "createdAt", "updatedAt"]
    },
    "BehaviorCategory": {
      "title": "BehaviorCategory",
      "description": "Customizable sub-criteria and weights for each of the four main behavioral axes.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "profileId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "key": { "type": "string", "enum": ["obedience", "study", "prayer", "responsibilities"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "weight": { "type": "integer" },
        "subCriteria": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "profileId", "key", "title", "description", "weight", "subCriteria", "updatedAt"]
    },
    "DailyAssessment": {
      "title": "DailyAssessment",
      "description": "Daily behavioral assessment record across the four axes with draft/finalized state and manual override audit.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "profileId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "dateKey": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 10 },
        "status": { "type": "string", "enum": ["draft", "finalized"] },
        "axisStates": { "type": "object" },
        "scores": { "type": "object" },
        "manualOverride": { "type": "object" },
        "dailyEvents": { "type": "string", "maxLength": 3000 },
        "endOfDaySummary": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "profileId", "dateKey", "status", "axisStates", "scores", "dailyEvents", "endOfDaySummary", "createdAt", "updatedAt"]
    },
    "BehaviorObservation": {
      "title": "BehaviorObservation",
      "description": "Logged daily observation for listening, obedience, and respectful communication.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "profileId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "dateKey": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 10 },
        "situation": { "type": "string", "minLength": 1, "maxLength": 500 },
        "guidanceGiven": { "type": "string", "minLength": 1, "maxLength": 500 },
        "reaction": { "type": "string", "minLength": 1, "maxLength": 500 },
        "outcome": { "type": "string", "enum": ["positive", "partial", "needs_support"] },
        "firstTimeResponse": { "type": "boolean" },
        "neededReminder": { "type": "boolean" },
        "criterionKey": { "type": "string", "maxLength": 80 },
        "isPoliteQuestion": { "type": "boolean" },
        "pointsAwarded": { "type": "integer" },
        "notes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "profileId", "dateKey", "situation", "guidanceGiven", "reaction", "outcome", "firstTimeResponse", "neededReminder", "criterionKey", "isPoliteQuestion", "pointsAwarded", "notes", "createdAt"]
    },
    "StudySession": {
      "title": "StudySession",
      "description": "Study session log with focus rating, quality rating, goals, and actual duration.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "profileId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "dateKey": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 10 },
        "subject": { "type": "string", "minLength": 1, "maxLength": 120 },
        "goalDescription": { "type": "string", "minLength": 1, "maxLength": 300 },
        "targetMinutes": { "type": "integer" },
        "startTime": { "type": "string", "maxLength": 20 },
        "endTime": { "type": "string", "maxLength": 20 },
        "actualMinutes": { "type": "integer" },
        "activityType": { "type": "string", "enum": ["homework", "review", "exercises", "reading"] },
        "focusLevel": { "type": "integer" },
        "qualityRating": { "type": "integer" },
        "status": { "type": "string", "enum": ["completed", "partial", "incomplete", "postponed"] },
        "postponeReason": { "type": "string", "maxLength": 300 },
        "notes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "profileId", "dateKey", "subject", "goalDescription", "targetMinutes", "startTime", "endTime", "actualMinutes", "activityType", "focusLevel", "qualityRating", "status", "postponeReason", "notes", "createdAt"]
    },
    "PrayerRecord": {
      "title": "PrayerRecord",
      "description": "Private daily record for the five daily prayers.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "profileId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "dateKey": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 10 },
        "prayers": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "profileId", "dateKey", "prayers", "updatedAt"]
    },
    "Responsibility": {
      "title": "Responsibility",
      "description": "Recurring responsibility template assigned to a profile.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "profileId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "maxLength": 500 },
        "dueTime": { "type": "string", "maxLength": 20 },
        "priority": { "type": "string", "enum": ["high", "medium", "low"] },
        "recurrence": { "type": "string", "enum": ["daily", "weekly", "monthly"] },
        "requiresProof": { "type": "boolean" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "profileId", "title", "description", "dueTime", "priority", "recurrence", "requiresProof", "active", "createdAt"]
    },
    "TaskItem": {
      "title": "TaskItem",
      "description": "Individual daily responsibility task instance with optional photo proof and guardian approval.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "profileId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "responsibilityId": { "type": "string", "maxLength": 128 },
        "dateKey": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 10 },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "maxLength": 500 },
        "dueTime": { "type": "string", "maxLength": 20 },
        "priority": { "type": "string", "enum": ["high", "medium", "low"] },
        "recurrence": { "type": "string", "enum": ["daily", "weekly", "monthly"] },
        "status": { "type": "string", "enum": ["pending", "completed", "partial", "missed"] },
        "completedAt": { "type": "string", "maxLength": 64 },
        "proofImageDataUrl": { "type": "string", "maxLength": 200000 },
        "guardianApproved": { "type": "boolean" },
        "guardianApprovedBy": { "type": "string", "maxLength": 120 },
        "notes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "profileId", "responsibilityId", "dateKey", "title", "description", "dueTime", "priority", "recurrence", "status", "guardianApproved", "notes", "createdAt", "updatedAt"]
    },
    "Reward": {
      "title": "Reward",
      "description": "Positive motivational reward defined by guardian.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "profileId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 140 },
        "description": { "type": "string", "maxLength": 400 },
        "category": { "type": "string", "maxLength": 60 },
        "costPoints": { "type": "integer" },
        "redeemed": { "type": "boolean" },
        "redeemedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "profileId", "title", "description", "category", "costPoints", "redeemed", "createdAt"]
    },
    "Achievement": {
      "title": "Achievement",
      "description": "Earned badge or milestone.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "profileId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "badgeKey": { "type": "string", "minLength": 1, "maxLength": 64 },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 300 },
        "pointsBonus": { "type": "integer" },
        "earnedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "profileId", "badgeKey", "title", "description", "pointsBonus", "earnedAt"]
    },
    "AIInsight": {
      "title": "AIInsight",
      "description": "AI-generated behavioral analysis grounded strictly in logged records, subject to guardian review.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "profileId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "dateKey": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 10 },
        "period": { "type": "string", "enum": ["daily", "weekly", "monthly"] },
        "summary": { "type": "string", "maxLength": 2000 },
        "strongestAxis": { "type": "string", "maxLength": 120 },
        "improvementAxis": { "type": "string", "maxLength": 120 },
        "recurringPatterns": { "type": "string", "maxLength": 1000 },
        "studyConsistency": { "type": "string", "maxLength": 1000 },
        "responsibilityFollowup": { "type": "string", "maxLength": 1000 },
        "prayerSummary": { "type": "string", "maxLength": 1000 },
        "performanceDelta": { "type": "string", "maxLength": 1000 },
        "recommendations": { "type": "array" },
        "status": { "type": "string", "enum": ["pending_review", "approved", "rejected"] },
        "approvedBy": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "profileId", "dateKey", "period", "summary", "strongestAxis", "improvementAxis", "recurringPatterns", "studyConsistency", "responsibilityFollowup", "prayerSummary", "performanceDelta", "recommendations", "status", "createdAt"]
    },
    "BehaviorReport": {
      "title": "BehaviorReport",
      "description": "Saved daily, weekly, or monthly summary report.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "profileId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "reportType": { "type": "string", "enum": ["daily", "weekly", "monthly"] },
        "periodStart": { "type": "string", "maxLength": 10 },
        "periodEnd": { "type": "string", "maxLength": 10 },
        "averageScore": { "type": "number" },
        "axisAverages": { "type": "object" },
        "highlights": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "profileId", "reportType", "periodStart", "periodEnd", "averageScore", "axisAverages", "highlights", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable audit log entry recording manual score overrides and guardian actions.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "profileId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "action": { "type": "string", "minLength": 1, "maxLength": 80 },
        "entityType": { "type": "string", "minLength": 1, "maxLength": 80 },
        "entityId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "actorName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "reason": { "type": "string", "maxLength": 500 },
        "details": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "profileId", "action", "entityType", "entityId", "actorName", "reason", "details", "createdAt"]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Server-managed admin marker document.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "required": ["uid"]
    },
    "SubscriptionSettings": {
      "title": "SubscriptionSettings",
      "description": "Global WhatsApp support number and default monthly subscription fee configured by admin.",
      "type": "object",
      "properties": {
        "whatsappNumber": { "type": "string", "maxLength": 24 },
        "defaultMonthlyPrice": { "type": "number" },
        "currency": { "type": "string", "maxLength": 16 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["whatsappNumber", "defaultMonthlyPrice", "currency", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Guardian user account document isolated to owner."
    },
    "/users/{userId}/profiles/{profileId}": {
      "schema": { "$ref": "#/entities/MonitoredProfile" },
      "description": "Monitored person profile belonging to the guardian."
    },
    "/users/{userId}/profiles/{profileId}/behaviorCategories/{categoryId}": {
      "schema": { "$ref": "#/entities/BehaviorCategory" },
      "description": "Custom criteria and weights for the 4 axes."
    },
    "/users/{userId}/profiles/{profileId}/dailyAssessments/{dateKey}": {
      "schema": { "$ref": "#/entities/DailyAssessment" },
      "description": "Daily assessment documents keyed by YYYY-MM-DD."
    },
    "/users/{userId}/profiles/{profileId}/observations/{obsId}": {
      "schema": { "$ref": "#/entities/BehaviorObservation" },
      "description": "Daily listening and obedience observations."
    },
    "/users/{userId}/profiles/{profileId}/studySessions/{sessionId}": {
      "schema": { "$ref": "#/entities/StudySession" },
      "description": "Study sessions with focus timer and quality scores."
    },
    "/users/{userId}/profiles/{profileId}/prayerRecords/{dateKey}": {
      "schema": { "$ref": "#/entities/PrayerRecord" },
      "description": "Private daily 5-prayer log keyed by YYYY-MM-DD."
    },
    "/users/{userId}/profiles/{profileId}/responsibilities/{respId}": {
      "schema": { "$ref": "#/entities/Responsibility" },
      "description": "Recurring responsibility definitions."
    },
    "/users/{userId}/profiles/{profileId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/TaskItem" },
      "description": "Daily task instances with proof and guardian approval."
    },
    "/users/{userId}/profiles/{profileId}/rewards/{rewardId}": {
      "schema": { "$ref": "#/entities/Reward" },
      "description": "Custom positive rewards."
    },
    "/users/{userId}/profiles/{profileId}/achievements/{achId}": {
      "schema": { "$ref": "#/entities/Achievement" },
      "description": "Earned badges and achievements."
    },
    "/users/{userId}/profiles/{profileId}/aiInsights/{insightId}": {
      "schema": { "$ref": "#/entities/AIInsight" },
      "description": "AI behavioral insights pending or approved by guardian."
    },
    "/users/{userId}/profiles/{profileId}/reports/{reportId}": {
      "schema": { "$ref": "#/entities/BehaviorReport" },
      "description": "Saved behavioral reports."
    },
    "/users/{userId}/profiles/{profileId}/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable audit trail for score overrides and guardian actions."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRole" },
      "description": "Admin role lookup collection."
    },
    "/appSettings/{settingId}": {
      "schema": { "$ref": "#/entities/SubscriptionSettings" },
      "description": "Global application subscription & WhatsApp support configuration."
    }
  }
}
