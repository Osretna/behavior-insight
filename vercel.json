{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{firebase-applet-config.json,server/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/__/auth/(.*)",
      "destination": "https://gen-lang-client-0997308923.firebaseapp.com/__/auth/$1"
    },
    {
      "source": "/((?!assets/|src/assets/|api/|__/|manifest\\.webmanifest|sw\\.js|workbox-|pwa-|apple-touch-icon|icon\\.svg|favicon).*)",
      "destination": "/index.html"
    }
  ]
}
